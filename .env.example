# Backend: an Ollama API key from https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here
# Backend: a model Ollama Cloud serves, such as gemma4:31b
OLLAMA_MODEL=gemma4:31b
# Backend: the PostgreSQL server on this machine only; a remote host is refused at startup
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@127.0.0.1:5432/assistant
# Backend: comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
# Frontend
NEXT_PUBLIC_ASSISTANT_URL=http://127.0.0.1:8200
